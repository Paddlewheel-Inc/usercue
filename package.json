{
  "name": "usercue",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel --filter '@usercue/*' dev",
    "docker:dev": "docker compose -f docker-compose.dev.yml up --build",
    "docker:dev:tunnel": "docker compose -f docker-compose.dev.yml --profile tunnel up --build",
    "docker:dev:down": "docker compose -f docker-compose.dev.yml --profile tunnel down",
    "build": "bun run --filter @usercue/web build",
    "start": "bun run --filter @usercue/server start",
    "typecheck": "bun run --filter '*' typecheck && tsc -p scripts",
    "lint": "biome check .",
    "format": "biome check --write .",
    "version:check": "bun scripts/version.ts check",
    "version:prepare": "bun scripts/version.ts prepare",
    "test:release": "bun test scripts/version.test.ts scripts/promote-latest.test.ts apps/server/src/version.test.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/bun": "^1.4.4",
    "typescript": "^5.9.0"
  },
  "version": "1.0.3"
}
