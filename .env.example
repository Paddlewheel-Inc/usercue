# Image the production stack runs. The default is the published UserCue image.
# Set this to an image in your own registry if you build and host it yourself.
USERCUE_IMAGE=ghcr.io/paddlewheel-inc/usercue:latest

# Port the API listens on. In dev, Vite proxies /api here.
# Docker publishes this same port on the host, so set it to a free port
# when 3000 is already taken.
PORT=3000

# Postgres connection string. On a fresh local machine the server
# creates the usercue role and database if they are not there yet.
# Point this at the real database before you deploy.
DATABASE_URL=postgres://usercue:usercue@localhost:5432/usercue

# Where uploaded images go, and where the generated encryption key
# is stored if SECRET_KEY is left empty. The folder is created on startup.
DATA_DIR=data

# Turn this on only when the site is served over HTTPS. Session cookies
# are then marked Secure, and browsers will not send them over plain HTTP.
COOKIE_SECURE=false

# Encrypts OAuth client secrets and webhook URLs before they are saved.
# Leave it empty in development and a key file is written into DATA_DIR.
# In production, set a long random value so the key survives a new disk.
SECRET_KEY=

# The address people actually open, such as https://feedback.example.com.
# Set this behind a reverse proxy. OAuth redirect URLs are built from it,
# and they have to match what you registered with each provider.
PUBLIC_URL=

# Optional way to email staff invites through Resend. The settings page
# is the better place for this: the key is hashed and encrypted there.
# These two are used only when settings do not already have a key and a from address.
RESEND_API_KEY=
RESEND_FROM=UserCue <noreply@example.com>

# Optional SMTP fallback for invite emails when Resend is not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=UserCue <noreply@example.com>
SMTP_SECURE=false

# Optional: expose the dev server via Cloudflare Tunnel
# Run with: bun docker:dev:tunnel
CLOUDFLARE_TUNNEL_TOKEN=
